# Copy this file to .env and set real values. .env is ignored by git.
# Variables already set in the environment win over values in .env.

# MySQL DSN (go-sql-driver/mysql format). Replace the placeholder password.
# The service refuses to start while the DSN contains YOUR_PASSWORD_HERE.
DATABASE_DSN=root:YOUR_PASSWORD_HERE@tcp(127.0.0.1:3306)/warehouse?parseTime=true&multiStatements=true

# Address of the HTTP server.
HTTP_ADDR=:8080

# debug, info, warn or error.
LOG_LEVEL=info

# Apply pending migrations when the server starts.
AUTO_MIGRATE=true

# Default over/under receipt tolerance in basis points (500 = 5%).
RECEIPT_TOLERANCE_BP=500

# How long to wait for open requests on shutdown.
SHUTDOWN_TIMEOUT=15s

# Only for integration tests. The database name must end with _test.
# TEST_DATABASE_DSN=root:YOUR_PASSWORD_HERE@tcp(127.0.0.1:3306)/warehouse_test
